# Copy to .env and fill in. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-api-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Slack ---
# Workflow 1 — channel webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Workflow 2 — Slack App Bot Token (chat:write + im:write scopes required)
SLACK_BOT_TOKEN=xoxb-...
# Channel ID where Workflow 1 summary posts. Bot must be a member.
SLACK_CHANNEL_ID=C0XXXXXXXXX
# App-level token (connections:write) for the Replied / Skip button listener.
# Slack app settings → Socket Mode → enable, then generate the token here.
SLACK_APP_TOKEN=xapp-...

# --- SerpApi (Google search, site:reddit.com) — https://serpapi.com ---
SERPAPI_KEY=

# --- Jina Reader (optional) — https://jina.ai ---
JINA_API_KEY=

# --- Runtime config ---
SCORE_THRESHOLD=7
LOOKBACK=qdr:w
MIN_REDDIT_COMMENTS=3
MAX_OR_TERMS_PER_QUERY=5
# Path (relative to repo root) of the keywords file to use.
# Default = config/keywords.yaml.
KEYWORDS_FILE=config/keywords.yaml

# --- Dedup store: local | dynamodb ---
DEDUP_BACKEND=local
DYNAMODB_TABLE=antares-seen-urls
AWS_REGION=us-east-1
